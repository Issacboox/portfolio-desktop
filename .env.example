# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Used by the Supabase CLI for `npm run db:push`
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=

# AI (later phases)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Public site URL (canonical links, sitemap, social cards). On Vercel it defaults to the production domain.
NEXT_PUBLIC_SITE_URL=

# AI chat (Terminal / Ask my AI). Any OpenAI-compatible API; Groq's free tier is the default.
# Get a free key at https://console.groq.com/keys
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
# Optional limits (per server instance)
AI_LIMIT_PER_MINUTE=5
AI_LIMIT_PER_DAY=40
AI_LIMIT_GLOBAL_PER_DAY=800
